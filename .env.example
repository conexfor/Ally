# ---------------------------------------------------------------------------
# Ally — variables de entorno del backend.
# Copia este archivo a backend/.env (desarrollo) o configúralas en tu hosting.
# ---------------------------------------------------------------------------

# development | production
APP_ENV=development
HOST=0.0.0.0
PORT=8080

# PostgreSQL 14+. En producción usa sslmode=require o verify-full.
DATABASE_URL=postgresql://ally:cambia-esta-clave@localhost:5432/ally?sslmode=disable
# Aplica migraciones al arrancar (true por defecto).
RUN_MIGRATIONS=true

# Clave para firmar los tokens de acceso (mínimo 32 caracteres, aleatoria).
# Genera una con: openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=60

# Inicio de sesión con Google: IDs de cliente OAuth aceptados (separados por comas).
# Debe incluir el ID de cliente "Web" usado en la app (GOOGLE_SERVER_CLIENT_ID).
GOOGLE_CLIENT_IDS=
# Inicio de sesión con Apple (iOS): bundle id / services id aceptados.
APPLE_CLIENT_IDS=

# Notificaciones push (Firebase Cloud Messaging, API HTTP v1).
# Cuenta de servicio de Firebase: ruta al JSON o el JSON completo.
FCM_SERVICE_ACCOUNT_FILE=
FCM_SERVICE_ACCOUNT_JSON=
# Opcional: se toma del JSON si no se indica.
FCM_PROJECT_ID=

# Correo saliente (recuperación de contraseña). Sin SMTP los correos se escriben en el log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@tu-dominio.com
SMTP_SSL=false
# URL pública del servidor (HTTPS en producción). Se usa en los enlaces de los
# correos y en las páginas web: /reset-password, /verify-email, /c/<código>, /privacy.
PUBLIC_BASE_URL=http://localhost:8080
# Opcionales: por defecto $PUBLIC_BASE_URL/reset-password y $PUBLIC_BASE_URL/verify-email
PASSWORD_RESET_URL=
EMAIL_VERIFICATION_URL=

# Android App Links: los enlaces https de PUBLIC_BASE_URL abren la app directamente.
# Huella SHA-256 del certificado de firma (Play Console → Integridad de la app),
# varias separadas por comas. Se publica en /.well-known/assetlinks.json
ANDROID_PACKAGE_NAME=com.conexfor.ally
ANDROID_SHA256_CERT_FINGERPRINTS=

# Enlace a la ficha de Google Play (se muestra en la página de invitación).
PLAY_STORE_URL=

# Seguridad
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
# true solo si el servidor está detrás de un proxy de confianza (usa X-Forwarded-For).
TRUST_PROXY=false
